# Copied to /etc/knoxis.env by setup_vm.sh (mode 640, root:knoxis). Never commit the real file.
KNOXIS_PRODUCTION=1
# Sent as the X-Admin-Token header to reach /diagnostics. setup_vm.sh replaces this with a random value.
KNOXIS_ADMIN_TOKEN=change-me

# Data (archive of day files, trained model and its metadata)
KNOXIS_DAYS_DIR=/srv/knoxis/data/days
KNOXIS_MODEL_FILE=/srv/knoxis/data/model/knoxis_binary_flare_model.joblib
KNOXIS_META_FILE=/srv/knoxis/data/model/model_meta.json
# Archive only: no live feed. Leave this pointing at a file that does not exist.
KNOXIS_DATA_FILE=/srv/knoxis/data/live/latest_data.parquet
# Optional inputs for the Evaluation panel
#KNOXIS_METRICS_FILE=/srv/knoxis/data/model/metrics.json
#KNOXIS_TRUTH_FILE=/srv/knoxis/data/model/noaa_events.csv

# Must match NowcastEngine (display only) and the calibration used by the engine
KNOXIS_THRESHOLD_RATIO=1.4
KNOXIS_SUSTAIN_MINUTES=3
KNOXIS_GOES_FACTOR=1.379e-8
KNOXIS_LEADIN_HOURS=24

# Protection (defaults shown)
#KNOXIS_RATE_LIMIT_PER_MIN=240
#KNOXIS_MAX_BUILD_QUEUE=6
#KNOXIS_CORS_ORIGINS=https://knoxis.in,https://www.knoxis.in
#KNOXIS_ALLOWED_HOSTS=knoxis.in,www.knoxis.in,127.0.0.1,localhost
